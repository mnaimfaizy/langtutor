{
  "name": "lang-tutor",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "node -r ./scripts/eslint-register.cjs ./node_modules/eslint/bin/eslint.js .",
    "lint:fix": "node -r ./scripts/eslint-register.cjs ./node_modules/eslint/bin/eslint.js . --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "verify": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test",
    "db:generate:postgres": "drizzle-kit generate --config drizzle.postgres.config.ts",
    "db:migrate:postgres": "tsx scripts/migrate-postgres.mts",
    "data:build-wordnet": "node scripts/build-wordnet.mjs",
    "data:build-words-cefr": "node scripts/build-words-cefr.mjs",
    "sandcastle": "pnpm exec tsx .sandcastle/main.mts",
    "sandcastle:build": "npx sandcastle docker build-image",
    "sandcastle:issue": "pnpm exec tsx .sandcastle/main.mts --issue"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^2.0.51",
    "@base-ui/react": "^1.6.0",
    "@node-rs/argon2": "^2.0.2",
    "@serwist/turbopack": "^9.5.11",
    "@supabase/supabase-js": "^2.49.8",
    "ai": "^6.0.208",
    "better-sqlite3": "^12.11.1",
    "clsx": "^2.1.1",
    "dexie": "^4.4.4",
    "drizzle-orm": "^0.45.2",
    "framer-motion": "^12.40.0",
    "next": "16.2.9",
    "postgres": "^3.4.7",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "ts-fsrs": "^5.4.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@ai-hero/sandcastle": "^0.10.0",
    "@playwright/test": "^1.61.0",
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "eslint-config-prettier": "^10.1.8",
    "fake-indexeddb": "^6.2.5",
    "prettier": "^3.8.4",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "serwist": "^9.5.11",
    "sharp": "^0.35.2",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5",
    "vitest": "^4.1.9",
    "wordpos": "^2.1.0"
  }
}
