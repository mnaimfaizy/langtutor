# ─── Public site URL (metadata only) ─────────────────────────────────────────
# Absolute origin used for canonical links and Open Graph/Twitter card URLs on the public
# landing page. Falls back to Vercel's auto-injected VERCEL_URL, then localhost — only set
# this explicitly if you want a custom production domain reflected in share previews.
# NEXT_PUBLIC_SITE_URL=https://langtutor.example.com

# ─── App mode (discriminant for Zod env validation) ─────────────────────────
# "local" = SQLite + hand-rolled auth.  "cloud" = Postgres + Supabase Auth.
LANGTUTOR_MODE=local

# ─── SQLite database ─────────────────────────────────────────────────────────
# Path to the SQLite file.  The directory must exist; the file is created on
# first boot.  Default: ./langtutor.db (relative to the Next.js project root).
LANGTUTOR_DB_PATH=./langtutor.db

# ─── Session secret ───────────────────────────────────────────────────────────
# Must NOT be the literal string "change-me-in-production" — the app rejects it.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
LANGTUTOR_SESSION_SECRET=<generate-a-real-secret-see-above>

# ─── Mac (Ollama, OpenAI-compatible API) — seeded into appConfig on boot ─────
# These values are written to the `app_config` table on first run; afterwards
# the DB row is the source of truth and can be edited in the admin UI.
# Use the Mac's LAN IP at home, or its Tailscale hostname when away.
MAC_LLM_BASE_URL=http://localhost:11434/v1
# Ollama ignores auth, but the OpenAI-compatible client sends this as Bearer.
MAC_LLM_API_KEY=ollama

# Model roster (all swappable — PLAN §1 #5).
MAC_LLM_MODEL=qwen2.5:14b-instruct
MAC_UTILITY_MODEL=qwen2.5:7b-instruct
MAC_EMBED_MODEL=nomic-embed-text

# Whisper STT server (whisper.cpp or faster-whisper).
MAC_STT_URL=http://localhost:8080

# ─── Cloud AI (Groq) — server-only secrets (ADR 0010) ────────────────────────
# In LANGTUTOR_MODE=cloud, Groq becomes the default chat + STT provider.
# GROQ_API_KEY=gsk_...
# Optional env-first default chat model (otherwise falls back to app-config/UI, then built-in default).
# GROQ_CHAT_MODEL=llama-3.3-70b-versatile
# Optional env-first default STT model.
# GROQ_STT_MODEL=whisper-large-v3
# Used by GET /api/audio/resolve for pre-A1 kid vocabulary TTS (Orpheus English).
# Requires GROQ_API_KEY above.

# ─── Cloud AI (Mistral) — server-only secrets (ADR 0010) ───────────────────
# In LANGTUTOR_MODE=cloud, Mistral becomes the default embeddings provider.
# MISTRAL_API_KEY=...
# Optional env-first default embeddings model.
# MISTRAL_EMBED_MODEL=mistral-embed

# ─── Image generation — server-only secrets (ADR 0016) ───────────────────────
# Used by GET /api/image/resolve for pre-A1 kid vocabulary illustrations.
#
# Primary (recommended free tier): Cloudflare Workers AI (FLUX.1-schnell).
# Account ID is 32-char hex (not the API token). Token needs Workers AI Read + Edit.
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
#
# Follow-up: NVIDIA NIM (FLUX.1-schnell). Key starts with nvapi-...
# Provision at https://build.nvidia.com — free tier is rate/capacity limited (504s under load).
# NVIDIA_NIM_API_KEY=nvapi-...
#
# Provider switch: nvidia | cloudflare | auto
# (default = auto: Cloudflare then NVIDIA on 404/429/5xx/timeout when both configured).
# IMAGE_GENERATOR_PROVIDER=auto

# ─── Cloud mode (Phase 2+) ───────────────────────────────────────────────────
# Uncomment and fill when running LANGTUTOR_MODE=cloud with local or hosted Supabase.
# LANGTUTOR_MODE=cloud
# ── Two connection strings are needed for cloud deployments ──────────────────
#
# DATABASE_URL           — runtime connection used by Vercel serverless functions.
#                          Must be the Transaction Pooler URL (port 6543, IPv4-safe):
#   postgresql://postgres.<project-ref>:<password>@aws-<region>.pooler.supabase.com:6543/postgres
#   Get from: Supabase Dashboard → Connect → Transaction mode tab
#
# DATABASE_MIGRATION_URL — one-off migration URL (pnpm db:migrate:postgres).
#                          Must be the Session Pooler URL (port 5432, IPv4-safe, full DDL):
#   postgresql://postgres.<project-ref>:<password>@aws-<region>.pooler.supabase.com:5432/postgres
#   Get from: Supabase Dashboard → Connect → Session mode tab
#   Falls back to DATABASE_URL when not set.
#
# ⚠️  Do NOT use the Direct Connection URL (db.<ref>.supabase.co:5432) on free tier —
#     it is IPv6-only and unreachable from most local machines and Vercel functions.
#
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-<region>.pooler.supabase.com:6543/postgres
# DATABASE_MIGRATION_URL=postgresql://postgres.<project-ref>:<password>@aws-<region>.pooler.supabase.com:5432/postgres
#
# Optional: enable runtime Drizzle migrations on server startup/request paths.
# Keep unset/false on Vercel production; run migrations out-of-band with:
#   pnpm db:migrate:postgres
# LANGTUTOR_RUN_MIGRATIONS=false
# NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# NEXT_PUBLIC_SUPABASE_ANON_KEY=<from supabase start>
# SUPABASE_SERVICE_ROLE_KEY=<from supabase start>
# LANGTUTOR_ADMIN_EMAIL=admin@localhost.com
# LANGTUTOR_ADMIN_PASSWORD=<min-8-chars>
