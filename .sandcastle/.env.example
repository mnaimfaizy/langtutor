# Sandcastle environment variables
# Copy this file to .sandcastle/.env and fill in the values.
# .env is gitignored — never commit your API key.

# Optional: default agent provider for dispatch.
# Supported values: claude, cursor, copilot
SANDCASTLE_AGENT=claude

# Optional: default model overrides per provider.
SANDCASTLE_CLAUDE_MODEL=claude-sonnet-4-6
SANDCASTLE_CURSOR_MODEL=composer-2
SANDCASTLE_COPILOT_MODEL=claude-sonnet-4.5

# Optional: verbose container logs. When enabled (default), a human-readable
# event log (thinking blocks, tool calls, agent messages, result summary) is
# written to .sandcastle/logs/issue-N-<agent>-<stamp>-events.log.
# Set to 0 to disable.
# SANDCASTLE_VERBOSE=1

# Optional: raw stream-JSON dumps for deep post-mortems. When set to 1, every
# raw stdout line the agent emits is also appended to the main run log.
# SANDCASTLE_RAW_LOGS=0

# Required for Claude Code agents.
# Provide one of:
# Claude Code OAuth token — get one by running `claude setup-token` on your host.
CLAUDE_CODE_OAUTH_TOKEN=your-token-here
# ANTHROPIC_API_KEY=your-key-here

# Required for Cursor agents.
# CURSOR_API_KEY=your-cursor-api-key

# Required for GitHub Copilot CLI agents.
# COPILOT_GITHUB_TOKEN=your-github-token-here

# GitHub personal access token — the agent uses it to read and manage GitHub Issues
# Create a fine-grained token: https://github.com/settings/personal-access-tokens/new
# Required repository permissions: Issues (Read and write) and Metadata (Read)
GH_TOKEN=
